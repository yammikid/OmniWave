<Window x:Class="DynamicIsland.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="OmniWave"
        Icon="pack://application:,,,/Assets/omniwave.ico"
        Width="1220" Height="730"
        MinWidth="760" MinHeight="540"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="-1"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid Background="Transparent">
        <TextBlock x:Name="FallbackLoadingText"
                   Text="✦ OmniWave — загрузка Clear Glass..."
                   Foreground="#88FFFFFF"
                   FontSize="13"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        <wv2:WebView2 x:Name="PlayerWebView"/>
    </Grid>
</Window>
