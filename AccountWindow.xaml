<Window x:Class="DynamicIsland.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Аккаунты OmniWave"
        Icon="pack://application:,,,/Assets/omniwave.ico"
        Width="520" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <Style x:Key="AccBtn" TargetType="Button">
            <Setter Property="Background" Value="#20FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#36FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4CFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="YandexBtn" TargetType="Button" BasedOn="{StaticResource AccBtn}">
            <Setter Property="Background" Value="#FFCC00"/>
            <Setter Property="Foreground" Value="#111116"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="VkBtn" TargetType="Button" BasedOn="{StaticResource AccBtn}">
            <Setter Property="Background" Value="#0077FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Border Margin="14"
            Background="#F712131A"
            BorderBrush="#24FFFFFF"
            BorderThickness="1"
            CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="8" Opacity="0.72"/>
        </Border.Effect>

        <StackPanel Margin="22,18,22,20">
            <!-- Шапка -->
            <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#FFCC00"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Аккаунты Яндекс Музыки и ВК" FontSize="16.5" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" Content="✕" Width="30" Height="30" Padding="0"
                        Style="{StaticResource AccBtn}" Click="Close_Click"/>
            </Grid>

            <!-- Карточка: Яндекс Музыка -->
            <Border Background="#0EFFFFFF" BorderBrush="#28FFCC00" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Яндекс Музыка" FontSize="14.5" FontWeight="Bold" Foreground="#FFCC00"/>
                            <TextBlock x:Name="YandexStatusText" Text="Не подключён" FontSize="12" Foreground="#88899C" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnSyncYandex" Content="Обновить плейлисты"
                                    Style="{StaticResource AccBtn}" Padding="10,6" FontSize="11.5"
                                    Margin="0,0,6,0" Visibility="Collapsed" Click="SyncYandex_Click"/>
                            <Button x:Name="BtnDisconnectYandex" Content="Выйти"
                                    Style="{StaticResource AccBtn}" Padding="10,6" FontSize="11.5"
                                    Visibility="Collapsed" Click="DisconnectYandex_Click"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Вход через официальный OAuth-клиент Яндекс Музыки (механика yandex2spotify): переносит «Мне нравится» в исходном порядке и плейлисты с обложками, а треки без прямого потока точно подбирает по длительности (±3 с) и артисту."
                               Foreground="#9A9BAE" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnLoginYandex" Grid.Column="0" Content="Войти через Яндекс (OAuth)"
                                Style="{StaticResource YandexBtn}" Margin="0,0,8,0" Click="LoginYandex_Click"/>
                        <Button x:Name="BtnImportYandexJson" Grid.Column="1" Content="Импорт JSON"
                                ToolTip="Импортировать список формата yandex2spotify: [{&quot;artist&quot;:&quot;...&quot;,&quot;track&quot;:&quot;...&quot;}]"
                                Style="{StaticResource AccBtn}" Padding="12,8" Click="ImportYandexJson_Click"/>
                    </Grid>

                    <Button x:Name="BtnToggleYandexManual" Content="Вставить OAuth-токен (y0_...) или URL вручную"
                            Style="{StaticResource AccBtn}" Margin="0,8,0,0" Padding="10,6" FontSize="11.5"
                            Background="#14FFFFFF" Foreground="#B8BACB" Click="ToggleYandexManual_Click"/>

                    <Grid x:Name="YandexManualPanel" Visibility="Collapsed" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#16FFFFFF" CornerRadius="10" Padding="10,7" Margin="0,0,8,0">
                            <Grid>
                                <TextBox x:Name="YandexManualTokenBox" Background="Transparent" BorderThickness="0"
                                         Foreground="White" CaretBrush="#FFCC00" FontSize="12.5"
                                         VerticalContentAlignment="Center"/>
                                <TextBlock x:Name="YandexManualTokenPlaceholder" Text="y0_... или URL с access_token="
                                           Foreground="#65FFFFFF" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                        <Button x:Name="BtnConnectYandexManual" Grid.Column="1" Content="Подключить"
                                Style="{StaticResource AccBtn}" Click="ConnectYandexManual_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Карточка: ВК Музыка -->
            <Border Background="#0EFFFFFF" BorderBrush="#330077FF" BorderThickness="1" CornerRadius="14" Padding="14,12" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ВКонтакте Музыка" FontSize="14.5" FontWeight="Bold" Foreground="#4DA3FF"/>
                            <TextBlock x:Name="VkStatusText" Text="Не подключён" FontSize="12" Foreground="#88899C" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnSyncVk" Content="Обновить плейлисты"
                                    Style="{StaticResource AccBtn}" Padding="10,6" FontSize="11.5"
                                    Margin="0,0,6,0" Visibility="Collapsed" Click="SyncVk_Click"/>
                            <Button x:Name="BtnDisconnectVk" Content="Выйти"
                                    Style="{StaticResource AccBtn}" Padding="10,6" FontSize="11.5"
                                    Visibility="Collapsed" Click="DisconnectVk_Click"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Вход через официальный OAuth ВКонтакте (Kate Mobile, как yandex2spotify): загружает «Мою музыку» в исходном порядке и плейлисты с обложками, а недоступные треки подбирает с проверкой длительности (±3 с)."
                               Foreground="#9A9BAE" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <Button x:Name="BtnLoginVk" Content="Войти через ВКонтакте (OAuth)" Style="{StaticResource VkBtn}"
                            Click="LoginVk_Click"/>

                    <Button x:Name="BtnToggleVkManual" Content="Вставить токен / URL или cookie remixsid вручную"
                            Style="{StaticResource AccBtn}" Margin="0,8,0,0" Padding="10,6" FontSize="11.5"
                            Background="#14FFFFFF" Foreground="#B8BACB" Click="ToggleVkManual_Click"/>

                    <Grid x:Name="VkManualPanel" Visibility="Collapsed" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#16FFFFFF" CornerRadius="10" Padding="10,7" Margin="0,0,8,0">
                            <Grid>
                                <TextBox x:Name="VkManualCookieBox" Background="Transparent" BorderThickness="0"
                                         Foreground="White" CaretBrush="#0077FF" FontSize="12.5"
                                         VerticalContentAlignment="Center"/>
                                <TextBlock x:Name="VkManualCookiePlaceholder" Text="vk1.a... / URL с access_token= или remixsid=..."
                                           Foreground="#65FFFFFF" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                        <Button x:Name="BtnConnectVkManual" Grid.Column="1" Content="Подключить"
                                Style="{StaticResource AccBtn}" Click="ConnectVkManual_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Кнопка синхронизации и статус -->
            <Button x:Name="BtnSyncNow" Content="Синхронизировать все плейлисты"
                    Style="{StaticResource AccBtn}" Click="SyncNow_Click"/>

            <TextBlock x:Name="TxtStatus" Text="" Foreground="#A5A6BA" FontSize="11.5"
                       TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>
    </Border>
</Window>
